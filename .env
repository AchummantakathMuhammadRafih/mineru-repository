# ==============================================================================
# MinerU Parser Configuration & Environment Variables
# ==============================================================================

# Enable LLM-based heading hierarchy correction (true/false)
# If true: PyMuPDF font-size heuristics are bypassed, and headings are corrected via Azure OpenAI
# If false: Original font-size clustering heuristic is used
USE_LLM_HIERARCHY=true

# ==============================================================================
# MinerU Parser Configuration & Environment Variables
# ==============================================================================

# Enable LLM-based heading hierarchy correction (true/false)
# If true: PyMuPDF font-size heuristics are bypassed, and headings are corrected via OpenAI or Azure OpenAI
# If false: Original font-size clustering heuristic is used
USE_LLM_HIERARCHY=false

# Option A: Direct OpenAI Credentials
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
# OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI Credentials
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
