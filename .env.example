# ==============================================================================
# MinerU Parser Configuration & Environment Variables
# ==============================================================================

# Enable LLM-based heading hierarchy correction (true/false)
# If true: PyMuPDF font-size heuristics are bypassed, and headings are corrected via Azure OpenAI
# If false: Original font-size clustering heuristic is used
USE_LLM_HIERARCHY=true

# Azure OpenAI Credentials
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview
